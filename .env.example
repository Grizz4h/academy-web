# Server-side secrets (never expose via VITE_*)
OPENAI_API_KEY=
OPENAI_REFLECTION_MODEL=gpt-5-mini
OPENAI_REFLECTION_PROMPT_VERSION=v1

# Required for backend startup (min 32 chars). Generate locally, never commit the value:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
ACADEMY_JWT_SECRET=

# Comma-separated legacy usernames allowed to call import/admin APIs (in addition to role=admin).
ACADEMY_ADMIN_USERNAMES=christoph

# Public username/password signup. Set 0 before OAuth rollout / on production.
ACADEMY_ALLOW_LEGACY_SIGNUP=0

# Set 1 in unit tests to skip identity ensure-on-startup side effects.
# ACADEMY_SKIP_IDENTITY_MIGRATION=0
