# Server-side secrets (never expose via VITE_*)
OPENAI_API_KEY=
OPENAI_REFLECTION_MODEL=gpt-5-mini
OPENAI_REFLECTION_PROMPT_VERSION=v1

# Required for backend startup (min 32 chars). Generate locally, never commit the value:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
ACADEMY_JWT_SECRET=

# Comma-separated legacy usernames allowed to call import/admin APIs (in addition to role=admin).
ACADEMY_ADMIN_USERNAMES=christoph

# Public username/password signup. Set 0 before OAuth rollout / on production.
ACADEMY_ALLOW_LEGACY_SIGNUP=0

# Set 1 in unit tests to skip identity ensure-on-startup side effects.
# ACADEMY_SKIP_IDENTITY_MIGRATION=0

# --- Supabase Auth (Phase 3C+) — server ---
# Project URL only for JWKS verification (no service-role in JWT verify path).
SUPABASE_URL=
# Required for Phase 3G account deletion of Google/Email users (Admin API). NEVER in VITE_*/frontend/Git.
# SUPABASE_SERVICE_ROLE_KEY=
# Optional legacy HS256 secret if project has not migrated to asymmetric JWKS:
# SUPABASE_JWT_SECRET=
# SUPABASE_JWT_AUDIENCE=authenticated
# SUPABASE_JWT_ISSUER=https://YOUR_REF.supabase.co/auth/v1
# SUPABASE_JWKS_URL=https://YOUR_REF.supabase.co/auth/v1/.well-known/jwks.json

# --- Persistence (Phase 4D) — server only ---
# json (default) | postgres — never switch to postgres without explicit cutover approval
STORAGE_BACKEND=json
# Postgres URI for STORAGE_BACKEND=postgres and migration CLI. Empty placeholder only.
# MANUAL ACTION REQUIRED: copy from Supabase → Project Settings → Database → Connection string.
DATABASE_URL=
