# Server-side secrets (never expose via VITE_*)
OPENAI_API_KEY=
OPENAI_REFLECTION_MODEL=gpt-5-mini
OPENAI_REFLECTION_PROMPT_VERSION=v1
# AI competency evidence (Phase 5B) — falls back to OPENAI_REFLECTION_MODEL when unset
OPENAI_EVIDENCE_MODEL=
OPENAI_EVIDENCE_PROMPT_VERSION=v1

# Required for backend startup (min 32 chars). Generate locally, never commit the value:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
ACADEMY_JWT_SECRET=

# Comma-separated legacy usernames allowed to call import/admin APIs (in addition to role=admin).
ACADEMY_ADMIN_USERNAMES=christoph

# Optional: extra creator-mode accounts (Szenenpool). Code defaults cover Christoph.
# ACADEMY_CREATOR_USERNAMES=
# ACADEMY_CREATOR_RINQ_USER_IDS=

# Public username/password signup. Set 0 before OAuth rollout / on production.
ACADEMY_ALLOW_LEGACY_SIGNUP=0

# Set 1 in unit tests to skip identity ensure-on-startup side effects.
# ACADEMY_SKIP_IDENTITY_MIGRATION=0

# --- Supabase Auth (Phase 3C+) — server ---
# Project URL only for JWKS verification (no service-role in JWT verify path).
SUPABASE_URL=
# Required for Phase 3G account deletion of Google/Email users (Admin API). NEVER in VITE_*/frontend/Git.
# SUPABASE_SERVICE_ROLE_KEY=
# Optional legacy HS256 secret if project has not migrated to asymmetric JWKS:
# SUPABASE_JWT_SECRET=
# SUPABASE_JWT_AUDIENCE=authenticated
# SUPABASE_JWT_ISSUER=https://YOUR_REF.supabase.co/auth/v1
# SUPABASE_JWKS_URL=https://YOUR_REF.supabase.co/auth/v1/.well-known/jwks.json

# --- Persistence (Phase 4D) — server only ---
# json (default) | postgres — never switch to postgres without explicit cutover approval
STORAGE_BACKEND=json
# Postgres URI for STORAGE_BACKEND=postgres and migration CLI. Empty placeholder only.
# MANUAL ACTION REQUIRED: copy from Supabase → Project Settings → Database → Connection string.
DATABASE_URL=
# Optional pool tuning (defaults: min=1 max=5 connect_timeout=10s). Keep max small with Supabase pooler.
# ACADEMY_PG_POOL_MIN=1
# ACADEMY_PG_POOL_MAX=5
# ACADEMY_PG_CONNECT_TIMEOUT=10

# Unified progression pipeline (Phase 5, default on). Set 0 only for emergency rollback.
# ACADEMY_PROGRESSION_UNIFIED_PIPELINE=0

# --- Stripe billing (Phase 5D) — server only, never VITE_* ---
# Keep secret + webhook signing secret + price in the SAME mode (all test OR all live).
# Go-live checklist: docs/ops/launch-ops.md §2
# STRIPE_SECRET_KEY=sk_test_…   # flip to sk_live_… only with Live whsec_ + Live price_
# STRIPE_WEBHOOK_SECRET=whsec_…
# STRIPE_PRICE_ID=price_…
# STRIPE_CHECKOUT_SUCCESS_URL=https://rinq-tank.de/account?checkout=success
# STRIPE_CHECKOUT_CANCEL_URL=https://rinq-tank.de/account?checkout=cancel
# STRIPE_PORTAL_RETURN_URL=https://rinq-tank.de/account
# ACADEMY_PUBLIC_URL=https://rinq-tank.de

# --- Transactional mail (Widerrufsbestätigung) — server only ---
# TODO PAID LAUNCH BLOCKER if unset: configure real SMTP on Hetzner
# ACADEMY_SMTP_HOST=
# ACADEMY_SMTP_PORT=587
# ACADEMY_SMTP_USER=kontakt@rinq-tank.de
# ACADEMY_SMTP_PASSWORD=
# ACADEMY_SMTP_FROM=kontakt@rinq-tank.de
# ACADEMY_SMTP_SECURE=false
# Legacy alias (still accepted): ACADEMY_SMTP_TLS=1  → STARTTLS

# DevLab /dev access without admin or premium bypass (comma-separated usernames).
# ACADEMY_DEV_USERNAMES=paywall-test,paywall-widerruf

RINQ_ADMIN_USER_IDS=
