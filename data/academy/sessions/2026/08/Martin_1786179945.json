  "drills": [
    {
      "id": "C1_D1",
      "title": "Welche Räume schützt die Defensive?",
      "drill_type": "paintable_rink_observation",
      "description": "Analysiere mehrere defensive Situationen und markiere, welche Räume das Team schützt, welche Räume besonders gefährlich wären und welche Räume bewusst zugelassen werden.",
      "didactics": {
        "explanation": "Defensive Systeme beginnen nicht erst beim Zweikampf. Entscheidend ist, welche Räume ein Team priorisiert.\n\nEine gute Defensive schützt nicht jeden Bereich gleichzeitig. Sie entscheidet, welche Räume geschlossen werden müssen und welche Bereiche weniger gefährlich sind.\n\nBeobachte nicht den Erfolg einer einzelnen Aktion, sondern die wiederkehrende Raumpriorität des Teams.",
        "observation_guide": {
          "what_to_watch": [
            "Welcher Raum wird vor dem Tor konsequent geschützt?",
            "Welche Passwege oder Angriffswege werden geschlossen?",
            "Welche Räume lässt die Defensive bewusst zu?",
            "Welche Räume wären für den Gegner besonders gefährlich?"
          ],
          "how_to_decide": [
            "Sammle mehrere Situationen innerhalb deiner Session",
            "Suche nach wiederkehrenden Raumprioritäten",
            "Bewerte die Struktur vor dem Ergebnis",
            "Markiere nicht den Ort des Pucks, sondern die Bedeutung des Raumes"
          ],
          "ignore": [
            "Einzelne Fehler oder Tore",
            "Nur die Position eines einzelnen Verteidigers",
            "Erfolg oder Misserfolg einer Aktion",
            "Eine Szene ohne wiederkehrendes Muster"
          ]
        },
        "learning_hint": "Defensive Systeme erkennst du zuerst daran, welche Räume eine Mannschaft besonders konsequent schützt."
      },
