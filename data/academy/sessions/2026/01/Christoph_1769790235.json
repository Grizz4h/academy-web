    {
      "id": "A1_D3",
      "title": "Winkel & Body Position: Lenkung wahrnehmen",
      "drill_type": "triangle_spotting",
      "description": "Transfer-Drill zur Überprüfung deiner Wahrnehmungsstabilität. Einsatz: Re-Live oder ruhige Live-Phase. Dauer: 1–2 Minuten pro Sequenz.",
      "didactics": {
        "drill_intro": {
          "title": "Worum geht es in diesem Drill?",
          "text": "Dieser Drill prüft, ob du Lenkung inzwischen automatisch erkennst. Triff eine schnelle, ehrliche Einschätzung, ohne zu analysieren. Dreiecke werden nur mitgeloggt – der Fokus bleibt auf Lenkung."
        },
        "observation_guide": {
          "what_to_watch": [
            "Erster Eindruck der Körperstellung (Winkel/Schulterachse)",
            "Gefühl für Raumkontrolle: bleibt die Mitte zu oder öffnet sie sich?",
            "Wirkt die Szene stabil (geführt) oder rutschig (unkontrolliert)?"
          ],
          "how_to_decide": [
            "Lenkung zuerst bewerten",
            "Entscheide spontan und bleib bei deinem ersten Eindruck",
            "Unklarheit ist erlaubt"
          ],
          "ignore": [
            "Puckgewinn oder -verlust",
            "Checks, Tempo oder Emotion",
            "Torchancen und Shots"
          ]
        },
        "inline_explanations": {
          "Kontrolliert (Mitte zu / nach außen geführt)": {
            "meaning": "Dein Eindruck ist: Der Gegner wird kontrolliert nach außen gehalten, die Mitte fühlt sich geschlossen an. Kein Puckgewinn nötig."
          },
          "Unklar (kein klares Bild)": {
            "meaning": "Du hast kein klares Bild (zu kurz, zu chaotisch, zu viele Einflüsse). Das ist zulässig und Teil des Drills."
          },
          "Offen / instabil (Mitte auf / Kontrolle verloren)": {
            "meaning": "Dein Eindruck ist: Die Mitte öffnet sich oder Kontrolle geht verloren (Verteidiger seitlich/hinter dem Gegner, Lenkung kippt)."
          }
        },
        "learning_hint": "Wenn es sich grob anfühlt, ist das richtig: Du trainierst Wiedererkennen, nicht Analyse."
      },
