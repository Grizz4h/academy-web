  "drills": [
    {
      "id": "A3_D5",
      "title": "Gap Control (Defensive Reads)",
      "drill_type": "event_log",
      "description": "Logge Umschaltmomente mit 2-Schritt-Read: Bleibt das Gap stabil oder kippt es - und welche direkte Folge entsteht daraus?",
      "didactics": {
        "goal": "Saubere Gap-Reads im Umschaltmoment treffen und direkte Folgen kontextbasiert zuordnen.",
        "why_it_matters": "Gap Control entscheidet früh, ob der Gegner kontrolliert bleibt oder in gefährliche Optionen kommt. Du trainierst Wahrnehmung vor der Chance, nicht Bewertung nach der Chance.",
        "explanation": "Beobachte IMMER direkt nach Puckverlust, abgefangenem Pass oder Turnover. Entscheide früh - bevor ein Rush oder eine Chance sichtbar wird.\n\nHauptfrage: Bleibt das Gap stabil - oder kippt es?\n\nWichtiger Denk-Shift: Nicht fragen 'Ist das ein Rush?', sondern 'Wer kontrolliert den Raum?'\n\nDistanz-Interpretation: Kleinerer Abstand ist nicht automatisch schlecht. Wenn der Verteidiger die Annaeherung kontrolliert, ist das gutes Gap. Wenn der Angreifer die Distanz erzwingt, kippt das Gap.",
        "observation_guide": {
          "what_to_watch": [
            "Trigger-Momente: Puckverlust, abgefangener Pass, Turnover",
            "Sofort danach: Umschaltmoment von Vorwaerts auf Rueckwaerts",
            "Abstand zwischen Verteidiger und puckführendem Angreifer",
            "Speed-Match: Kann der Verteidiger das Tempo matchen?",
            "Körperwinkel: lenkend/kontrollierend oder passiv/gerade rückwärts",
            "Raumkontrolle: bleibt Mitte zu oder öffnet sie sich?"
          ],
          "how_to_decide": [
            "Schritt 1: Gap-Zustand wählen -> stabil oder kippt",
            "Schritt 2: Folge nur aus dem passenden Gap-Kontext wählen",
            "Mikro-Merksatz: Abstand bleibt gleich -> stabil | Abstand wächst -> kippt",
            "Hinweis: Abstand wird kleiner ist nicht automatisch schlecht. Entscheidend ist, wer die Annäherung kontrolliert: Wenn der Verteidiger die Distanz bewusst schließt und den Gegner lenkt, bleibt das Gap stabil. Wenn der Angreifer die Situation erzwingt und der Verteidiger nur reagiert, kippt das Gap.",
            "Stabil-Kriterien: Abstand ca. 1-2 Stocklängen, Speed-Match, lenkender Winkel, Gegner nach außen, Mitte bleibt zu",
            "Kippt-Kriterien: Abstand wird größer, Speed-Match geht verloren, passiver Rückwärtsgang, Mitte öffnet, Gegner hat Entscheidungsfreiheit",
            "Entscheidende Zusatzfrage: Wer diktiert die Distanz?"
          ],
          "ignore": [
            "Nicht auf Rush oder Torchance warten",
            "Nicht rueckwirkend vom Outcome her entscheiden",
            "Nicht pauschal denken: Rush = schlecht verteidigt",
            "Nicht pauschal denken: Keine Chance = gut verteidigt",
            "Nicht pauschal denken: Viel Abstand = sicher"
          ]
        },
        "learning_hint": "Du trainierst Pattern Recognition im frühen Read. Entscheide zuerst über Raumkontrolle, dann über die direkte Folge. Keine freien Kombinationen: Die Folge muss zum Gap-Zustand passen."
      },
      "miniFeedback": {
        "trigger": "onNext",
        "oncePerSection": true,
        "groups": [
          {
            "when": {
              "gap_state": "stabil"
            },
            "questions": [
              "Wodurch blieb der Verteidiger in Kontrolle?",
              "War es eher Tempo, Winkel oder frühes Lesen?",
              "Fühlte sich der Abstand konstant oder aktiv angepasst an?"
            ]
          },
          {
            "when": {
              "gap_state": "kippt"
            },
            "questions": [
              "Woran kippte der Gap zuerst?",
              "War der Fehler eher Timing, Winkel oder Ausgangsabstand?",
              "Hätte der Verteidiger früher reagieren müssen?"
            ]
          }
        ]
      },
