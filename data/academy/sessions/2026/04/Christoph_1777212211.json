  "drills": [
    {
      "id": "A3_D4",
      "title": "Backchecking & Rückwärtsarbeit",
      "drill_type": "event_log",
      "description": "Beobachte Backchecking-Situationen im Umschaltmoment. Zentrale Frage: Verändert der Backchecker, was der Gegner tun kann?",
      "didactics": {
        "explanation": "Backchecking ist keine Frage von Einsatz oder Tempo – es ist eine Frage von Wirkung.\n\nNicht bewerten: wie schnell er ist, wie viel er läuft, ob er sich bemüht.\n\nSondern: ob sich die Optionen des Gegners verändern.\n\nLeitfrage: Verändert sich die Entscheidung des Gegners?",
        "observation_guide": {
          "when_to_observe": [
            "Gegner gewinnt den Puck",
            "Gegner startet in die Transition",
            "Backchecker kommt von hinten ins Spiel"
          ],
          "what_to_watch": [
            "Abstand zum Puckträger",
            "Laufweg und Winkel des Backcheckers",
            "Nimmt er Wege oder Optionen weg?",
            "Muss der Gegner etwas anpassen?"
          ],
          "how_to_decide": [
            "Verändert sich die Entscheidung des Gegners? → ja = Impact",
            "Macht der Gegner trotzdem das, was er geplant hatte? → nein = kein Impact",
            "Auch nah dran sein reicht nicht – entscheidend ist nur: Hat sich etwas für den Gegner verändert?"
          ],
          "common_mistakes": [
            "Viel Tempo bedeutet nicht automatisch gutes Backchecking",
            "Nähe zum Gegner bedeutet nicht automatisch Einfluss",
            "Einsatz ist nicht gleich Wirkung"
          ]
        },
        "inline_explanations": {
          "Raum reduziert": {
            "meaning": "Der Backchecker verengt den verfügbaren Raum für den Puckträger – der Gegner hat weniger Platz zum Arbeiten."
          },
          "Passoption genommen": {
            "meaning": "Durch die Position oder den Winkel des Backcheckers wird eine Passroute des Gegners blockiert oder unattraktiv."
          },
          "nach außen gedrängt": {
            "meaning": "Der Gegner wird durch die Backchecking-Bewegung in einen weniger gefährlichen Bereich gelenkt (Außen, Bande)."
          },
          "Druck ermöglicht": {
            "meaning": "Durch die saubere Rückwärtsarbeit kann die Defense schneller helfen oder der Gegner wird unter sofortigen Druck gesetzt."
          },
          "zu weit weg": {
            "meaning": "Der Backchecker ist zu weit vom Puck oder den relevanten Passwegen entfernt, um Einfluss auszuüben."
          },
          "zu spät": {
            "meaning": "Die Rückwärtsarbeit kommt zu spät – der Gegner hat seine Entscheidung bereits getroffen, bevor der Backchecker Einfluss nehmen konnte."
          },
          "falsche Linie": {
            "meaning": "Der Backchecker läuft auf der falschen Route zurück – er deckt nicht den relevanten Passweg oder Raum."
          },
          "nur hinterhergelaufen": {
            "meaning": "Der Spieler läuft hinterher, aber es ändert sich nichts an den Optionen des Gegners. Der Gegner macht trotzdem das, was er geplant hatte."
          }
        },
        "learning_hint": "Gutes Backchecking erkennst du daran, dass der Gegner weniger Optionen hat. Schlechtes Backchecking ist unsichtbar – der Gegner merkt es gar nicht."
      },
      "miniFeedback": {
        "trigger": "onNext",
        "oncePerSection": true,
        "groups": [
          {
            "when": {
              "backchecking_impact": "ja"
            },
            "questions": [
              "Was genau hat sich für den Gegner verändert – Raum, Passwege, oder Richtung?",
              "War die Wirkung sofort sichtbar oder erst verzögert erkennbar?",
              "Hätte der Gegner ohne diesen Backchecker dieselbe Option gehabt?"
            ]
          },
          {
            "when": {
              "backchecking_impact": "nein"
            },
            "questions": [
              "Woran lag es – Timing, Distanz, oder falsche Linie?",
              "Was hätte der Backchecker anders machen müssen, um Einfluss zu haben?",
              "Hat der Gegner seine ursprüngliche Option trotzdem durchgezogen?"
            ]
          }
        ]
      },
